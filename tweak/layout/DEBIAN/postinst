#!/bin/sh
# 不修改任何 App、不改 Info.plist、不需要重签名。
# 从旧包升级时清掉旧配置域，避免残留设置干扰。
rm -f /var/mobile/Library/Preferences/com.yourname.alipaynfcredirect.plist 2>/dev/null
echo ""
echo "=============================================="
echo " Alipay2NFC 已安装"
echo ""
echo " 打开官方支付宝贴碰一碰贴纸即可自动跳转到"
echo " 多开客户端。设置 → 碰一碰重定向 可调。"
echo "=============================================="
echo ""
if command -v uicache >/dev/null 2>&1; then uicache -a >/dev/null 2>&1 || true; fi
exit 0
